# =============================================================
# APALA — environment configuration (optional)
# =============================================================
# The dashboard works without any configuration when the backend runs on
# localhost:8000. To point it at another server, copy this file to
# frontend/.env.local and change the URLs. Never commit real .env files.
#
# The backend has no settings file: model and data paths are fixed to
#   V1_Classical_ML/models/            (model, scaler, feature names)
#   V1_Classical_ML/ml/data/processed/ (one *_labeled_features.csv per patient)

# --- Frontend (read by Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Base URL only: the app appends /ws/{patient_id}
NEXT_PUBLIC_WS_URL=ws://localhost:8000
